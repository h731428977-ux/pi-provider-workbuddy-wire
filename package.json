{
  "name": "pi-provider-workbuddy-wire",
  "version": "0.3.0",
  "description": "Pi extension for WorkBuddy with desktop-client wire compatibility, stable conversation identity, gzip chat requests, and native Claude Messages routing",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "license": "MIT",
  "author": "lorlike and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h731428977-ux/pi-provider-workbuddy-wire.git"
  },
  "homepage": "https://github.com/h731428977-ux/pi-provider-workbuddy-wire#readme",
  "bugs": {
    "url": "https://github.com/h731428977-ux/pi-provider-workbuddy-wire/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "workbuddy",
    "codebuddy",
    "provider",
    "ai"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai/compat",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run verify"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.4.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
