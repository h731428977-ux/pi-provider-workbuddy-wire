{
  "name": "pi-provider-workbuddy",
  "version": "0.2.0",
  "description": "Pi extension for WorkBuddy (CodeBuddy) — dual-region providers (CN + Global) with OAuth login, dynamic model catalog with credit multipliers, DSML tool-call recovery, and read-only credit/status commands",
  "type": "module",
  "license": "MIT",
  "author": "lorlike",
  "homepage": "https://github.com/lorlike/pi-provider-workbuddy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorlike/pi-provider-workbuddy.git"
  },
  "bugs": {
    "url": "https://github.com/lorlike/pi-provider-workbuddy/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "workbuddy",
    "codebuddy",
    "provider",
    "ai"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai/compat",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
